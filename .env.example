# Copy this file to .env and fill in the values shared by NeoStats at the event.
# Never commit .env.

# OpenAI-compatible endpoint, e.g. https://<resource>.services.ai.azure.com/openai/v1/
LLM_BASE_URL=
LLM_API_KEY=
# Deployment name to pass as `model`
LLM_MODEL=

# Optional: local open-source embedding model (run by fastembed, downloaded on first run).
# Leave blank for the default, BAAI/bge-small-en-v1.5 (384 dimensions).
EMBEDDING_MODEL=
# Optional: cross-encoder re-ranker (default jinaai/jina-reranker-v1-tiny-en); "none" disables it.
RERANKER_MODEL=

# Optional: a Qdrant server. Leave blank to run Qdrant embedded (data/qdrant/), no server needed.
QDRANT_URL=
QDRANT_API_KEY=

# Optional tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
