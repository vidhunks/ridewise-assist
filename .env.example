# Copy this file to .env and fill in the values shared by NeoStats at the event.
# Never commit .env.

# OpenAI-compatible endpoint, e.g. https://<resource>.services.ai.azure.com/openai/v1/
LLM_BASE_URL=
LLM_API_KEY=
# Deployment name to pass as `model`
LLM_MODEL=

# Optional: embedding deployment, if NeoStats provides one.
# Leave blank to use the local open-source model (BAAI/bge-small-en-v1.5).
EMBEDDING_MODEL=

# Optional tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
